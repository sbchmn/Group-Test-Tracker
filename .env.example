# Copy to .env and fill values. Never commit real secrets.
SECRET_KEY=your-super-long-random-secret-key-here-generate-with-openssl-rand-hex-32
# DATABASE_URL will be auto-provided by DigitalOcean Postgres component.
# For local dev with Postgres: postgresql://user:pass@localhost:5432/group_tests
# For local SQLite (default fallback): sqlite:///group_tests.db
DATABASE_URL=sqlite:///group_tests.db
FLASK_ENV=development
# Optional admin bootstrap (used by create-admin CLI if provided)
# ADMIN_DEFAULT_PASSWORD=changeme123

# Public legal pages. Replace these with reviewed deployment-specific values.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_MAILING_ADDRESS=
LEGAL_GOVERNING_LAW=
LEGAL_EFFECTIVE_DATE=September 12, 2026

# Managed deployments only: the control plane injects GTT_MANAGED_INTEGRATIONS
# as a secret JSON object using existing storage_* and mailjet_* config keys.
# It overrides the corresponding database settings for this tenant only.
# Standalone deployments continue to use the in-app configuration pages.
